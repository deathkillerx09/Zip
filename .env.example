# Local Windows/Linux configuration example. Copy to .env and edit if you prefer
# to set these yourself; "Start AI Money Town.bat" already sets sensible values.
# Never commit the real owner token or passwords.

# Database and generated product files
AI_MONEY_TOWN_DB=./data/town.db
AI_MONEY_TOWN_WORKSPACE=./workspace

# Owner token: owner-only actions are disabled until this is set.
AI_MONEY_TOWN_OWNER_TOKEN=replace-with-a-long-random-secret

# Optional HTTP Basic gate for the whole site (leave empty for local use).
AI_MONEY_TOWN_ACCESS_USERNAME=
AI_MONEY_TOWN_ACCESS_PASSWORD=

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=100
OLLAMA_TASK_TIMEOUT_SECONDS=110
OLLAMA_CHAT_MODEL=qwen3.5:0.8b
OLLAMA_IDEA_MODEL=qwen3.5:0.8b
OLLAMA_WORKER_MODEL=qwen3:4b
OLLAMA_MODEL_PRODUCT=
OLLAMA_MODEL_RESEARCH=
OLLAMA_MODEL_FINANCE=
OLLAMA_MODEL_QUALITY=
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=1024
OLLAMA_NUM_PREDICT=64

# Scheduler and worker limits (optimised for an i5 / 16 GB laptop, no GPU)
AI_MONEY_TOWN_SCHEDULER_SECONDS=20
AI_MONEY_TOWN_SCHEDULER_START_DELAY_SECONDS=5
AI_MONEY_TOWN_INITIAL_IDEA_DELAY_SECONDS=30
AI_MONEY_TOWN_TASK_CONCURRENCY=1
AI_MONEY_TOWN_TASK_MAX_ATTEMPTS=3
AI_MONEY_TOWN_TASK_RETRY_SECONDS=45
AI_MONEY_TOWN_STALE_TASK_SECONDS=900
AI_MONEY_TOWN_IDEA_TARGET_PER_HOUR=50
AI_MONEY_TOWN_IDEA_BATCH_SIZE=10
AI_MONEY_TOWN_IDEA_INTERVAL_SECONDS=720
AI_MONEY_TOWN_SIMULATED_CUSTOMERS=10000

# Request guards
AI_MONEY_TOWN_RATE_LIMIT_PER_MINUTE=240
AI_MONEY_TOWN_MAX_BODY_BYTES=2097152
