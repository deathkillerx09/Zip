# Copy to .env on the server; never commit the real .env file.
DOMAIN=town.example.com

# Private site gate (HTTP Basic) for every page and API request.
AI_MONEY_TOWN_ACCESS_USERNAME=town-owner
AI_MONEY_TOWN_ACCESS_PASSWORD=replace-with-a-long-unique-password

# Owner token for owner-only actions (approvals, ledger, product builds, retries).
# The browser stores it in sessionStorage only after you type it in the Treasury panel.
AI_MONEY_TOWN_OWNER_TOKEN=replace-with-a-long-random-secret

# Local models. Use the smallest model that produces acceptable output.
OLLAMA_CHAT_MODEL=qwen3.5:0.8b
OLLAMA_IDEA_MODEL=qwen3.5:0.8b
OLLAMA_WORKER_MODEL=qwen3.5:0.8b
# Optional per-category overrides (falls back to the worker model).
OLLAMA_MODEL_PRODUCT=
OLLAMA_MODEL_RESEARCH=
OLLAMA_MODEL_FINANCE=
OLLAMA_MODEL_QUALITY=
OLLAMA_TIMEOUT_SECONDS=100
OLLAMA_TASK_TIMEOUT_SECONDS=180

# Resource and safety limits.
AI_MONEY_TOWN_TASK_CONCURRENCY=1
AI_MONEY_TOWN_TASK_MAX_ATTEMPTS=3
AI_MONEY_TOWN_STALE_TASK_SECONDS=900
AI_MONEY_TOWN_RATE_LIMIT_PER_MINUTE=240
AI_MONEY_TOWN_MAX_BODY_BYTES=2097152
AI_MONEY_TOWN_IDEA_TARGET_PER_HOUR=50
AI_MONEY_TOWN_IDEA_BATCH_SIZE=10
AI_MONEY_TOWN_IDEA_INTERVAL_SECONDS=720

# Inside the compose network only: allows the app to reach the ollama service.
AI_MONEY_TOWN_ALLOW_REMOTE_OLLAMA=1
